# 1 = no GPU needed: canned answers, for building and testing the flow
MOCK=0
# Hugging Face token from the account that accepted the N-ATLaS and ASR model terms
HF_TOKEN=

# Language model: vllm (recommended) or transformers
LLM_BACKEND=vllm
LLM_MODEL=NCAIR1/N-ATLaS
VLLM_URL=http://localhost:8000/v1
# Only for LLM_BACKEND=transformers on GPUs with less than ~20 GB
LOAD_IN_4BIT=0

# NCAIR speech-recognition models (check names on https://huggingface.co/NCAIR1)
ASR_MODEL_HA=NCAIR1/Hausa-ASR
ASR_MODEL_IG=NCAIR1/Igbo-ASR
ASR_MODEL_YO=NCAIR1/Yoruba-ASR
ASR_MODEL_EN=NCAIR1/NigerianAccentedEnglish

# Optional spoken replies with Meta MMS-TTS
TTS_ENABLED=0

# Retrieval (leave empty for keyword search only)
EMBEDDING_MODEL=intfloat/multilingual-e5-small
TOP_K=4

# Telegram: create a bot with @BotFather and paste the token
TELEGRAM_BOT_TOKEN=
# WhatsApp: Twilio console > Messaging > Try it out > WhatsApp sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Public https URL of this server, no trailing slash: https://<NGROK_DOMAIN> on the GPU server
PUBLIC_BASE_URL=

# Required (the server won't start without it). Users are stored only as salted hashes.
# Generate once with: openssl rand -hex 32   and never change it (old users would be lost).
ID_SALT=

# ---- GPU server (scripts/gcp/setup.sh, scripts/run_all.sh) ---------------
# Fraction of GPU memory vLLM may use, and its context length.
#   Google Cloud L4 24 GB: 0.80 and 4096      40-48 GB cards: 0.60 and 8192
GPU_MEM=0.80
MAX_MODEL_LEN=4096
# If vLLM runs out of GPU memory on the L4, uncomment:
# VLLM_EXTRA_ARGS=--quantization fp8
# Fixed public address for WhatsApp: free account at dashboard.ngrok.com, copy the
# authtoken, and claim your free static domain (Domains page).
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
